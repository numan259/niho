# Copy this file to .env.local (git-ignored) and fill in your own key:
#   cp .env.example .env.local
#
# Get a free key at https://www.themoviedb.org/settings/api
# Either value works:
#   - "API Read Access Token" (long, starts with eyJ...)  ← recommended
#   - "API Key" (32 characters)
#
# Note: Vite bakes VITE_* values into the built app, so anyone who downloads the
# web build or APK can read it. TMDB keys are read-only, but don't reuse it elsewhere.
VITE_TMDB_API_KEY=
