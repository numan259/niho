VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_CINEPRO_URL=http://localhost:3000
# Opt in only after the deployed backend supports language parameters.
VITE_CINEPRO_LANGUAGE_PARAMS=false
# Optional absolute JSON source-list URL. See docs/cinepro-languages.md.
# After Cinepro implements the contract, set e.g. http://localhost:3000/sources
# Keep blank until then; do not point this at a master.m3u8 endpoint.
VITE_CINEPRO_SOURCES_URL=
